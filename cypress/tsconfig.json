{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "types": ["cypress", "node"],
    "typeRoots": ["../frontend/node_modules/@types", "../frontend/node_modules"]
  },
  "include": ["**/*.ts"]
}
