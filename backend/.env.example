PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# FRONTEND_URL must include the app's base path (/fofa) — it builds the
# verification/reset email links. CORS_ORIGIN is the bare origin (no path).
FRONTEND_URL=http://localhost:5173/fofa
CORS_ORIGIN=http://localhost:5173
UPLOADS_DIR=./uploads
DB_PATH=./fofa.db
NODE_ENV=development

# Optional: seed a pre-verified login on startup (bypasses email verification,
# needed where outbound SMTP is blocked). Set both to enable; changing
# ADMIN_PASSWORD and redeploying resets the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_CITY=N/A
ADMIN_STATE=N/A
